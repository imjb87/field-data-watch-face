<?xml version="1.0"?>
<!--
    Field Data Pixel

    Analogue field-instrument face based on the supplied reference design.
    The static dial is an image so the numerals and tick marks remain crisp;
    the hands and data panels are live Watch Face Format elements.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <BitmapFonts>
    <BitmapFont name="weather_icons_day">
      <Character name="0" resource="ic_unknown" width="96" height="96" />
      <Character name="1" resource="ic_clear" width="96" height="96" />
      <Character name="2" resource="ic_cloudy" width="96" height="96" />
      <Character name="3" resource="ic_fog" width="96" height="96" />
      <Character name="4" resource="ic_heavy_rain" width="96" height="96" />
      <Character name="5" resource="ic_heavy_snow" width="96" height="96" />
      <Character name="6" resource="ic_rain" width="96" height="96" />
      <Character name="7" resource="ic_snow" width="96" height="96" />
      <Character name="8" resource="ic_sunny" width="96" height="96" />
      <Character name="9" resource="ic_thunderstorm" width="96" height="96" />
      <Word name="10" resource="ic_sleet" width="96" height="96" />
      <Word name="11" resource="ic_snow" width="96" height="96" />
      <Word name="12" resource="ic_rain" width="96" height="96" />
      <Word name="13" resource="ic_fog" width="96" height="96" />
      <Word name="14" resource="ic_partly_cloudy_day" width="96" height="96" />
      <Word name="15" resource="ic_windy" width="96" height="96" />
    </BitmapFont>
    <BitmapFont name="weather_icons_night">
      <Character name="0" resource="ic_unknown" width="96" height="96" />
      <Character name="1" resource="ic_clear" width="96" height="96" />
      <Character name="2" resource="ic_cloudy" width="96" height="96" />
      <Character name="3" resource="ic_fog" width="96" height="96" />
      <Character name="4" resource="ic_heavy_rain" width="96" height="96" />
      <Character name="5" resource="ic_heavy_snow" width="96" height="96" />
      <Character name="6" resource="ic_rain" width="96" height="96" />
      <Character name="7" resource="ic_snow" width="96" height="96" />
      <Character name="8" resource="ic_sunny" width="96" height="96" />
      <Character name="9" resource="ic_thunderstorm" width="96" height="96" />
      <Word name="10" resource="ic_sleet" width="96" height="96" />
      <Word name="11" resource="ic_snow" width="96" height="96" />
      <Word name="12" resource="ic_rain" width="96" height="96" />
      <Word name="13" resource="ic_fog" width="96" height="96" />
      <Word name="14" resource="ic_partly_cloudy_night" width="96" height="96" />
      <Word name="15" resource="ic_windy" width="96" height="96" />
    </BitmapFont>
  </BitmapFonts>

  <Scene backgroundColor="#ff050505">
    <!-- The full static dial: numerals, markers, ticks, and four subdial rings. -->
    <PartImage x="0" y="0" width="450" height="450">
      <Image resource="dial_background" />
    </PartImage>

    <!-- Weather subdial. The icon changes with the current weather condition. -->
    <Condition>
      <Expressions>
        <Expression name="weather_is_day">[WEATHER.IS_DAY]</Expression>
      </Expressions>
      <Compare expression="weather_is_day">
        <PartText x="187" y="90" width="76" height="68">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="CENTER">
            <BitmapFont family="weather_icons_day" size="60">
              <Template><![CDATA[%s]]>
                <Parameter expression="[WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 14" />
              </Template>
            </BitmapFont>
          </Text>
        </PartText>
      </Compare>
      <Default>
        <PartText x="187" y="90" width="76" height="68">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="CENTER">
            <BitmapFont family="weather_icons_night" size="60">
              <Template><![CDATA[%s]]>
                <Parameter expression="[WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 14" />
              </Template>
            </BitmapFont>
          </Text>
        </PartText>
      </Default>
    </Condition>
    <PartText x="183" y="151" width="84" height="34">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="28" weight="BOLD" color="#fff4f0e8">
          <Template><![CDATA[%s°]]>
            <Parameter expression="[WEATHER.TEMPERATURE]" />
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- Steps subdial. -->
    <PartText x="91" y="207" width="108" height="38">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="27" weight="BOLD" color="#fff4f0e8">
          <Template><![CDATA[%s]]>
            <Parameter expression="[STEP_COUNT]" />
          </Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="91" y="238" width="108" height="25">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="17" color="#ffa4a4a4">STEPS</Font>
      </Text>
    </PartText>

    <!-- Heart-rate subdial. -->
    <PartImage x="279" y="193" width="52" height="52">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Image resource="heart" />
    </PartImage>
    <PartText x="263" y="242" width="84" height="39">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="31" weight="BOLD" color="#fff4f0e8">
          <Template><![CDATA[%s]]>
            <Parameter expression="[HEART_RATE] != null ? [HEART_RATE] : &quot;--&quot;" />
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- Date subdial. -->
    <PartText x="175" y="282" width="100" height="27">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="17" color="#ffa4a4a4">
          <Template><![CDATA[%s]]>
            <Parameter expression="[DAY_OF_WEEK_S]" />
          </Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="175" y="304" width="100" height="42">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="33" weight="BOLD" color="#fff4f0e8">
          <Template><![CDATA[%s]]>
            <Parameter expression="[DAY_Z]" />
          </Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="175" y="341" width="100" height="27">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="17" color="#ffa4a4a4">
          <Template><![CDATA[%s]]>
            <Parameter expression="[MONTH_S]" />
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- The analogue clock is drawn over the data panels. -->
    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hour" x="207" y="55" width="36" height="175"
        pivotX="0.5" pivotY="0.9714285714" />
      <MinuteHand resource="minute" x="210" y="25" width="30" height="205"
        pivotX="0.5" pivotY="0.9756097561" />
      <SecondHand resource="second" x="220" y="5" width="10" height="220"
        pivotX="0.5" pivotY="1.0">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Sweep frequency="15" />
      </SecondHand>
    </AnalogClock>

    <!-- Layered centre cap hides the hand pivots and matches the reference. -->
    <PartDraw x="206" y="206" width="38" height="38">
      <Ellipse x="0" y="0" width="38" height="38">
        <Stroke color="#ff050505" thickness="3" />
        <Fill color="#fff7f6f0" />
      </Ellipse>
      <Ellipse x="7" y="7" width="24" height="24">
        <Stroke color="#ff050505" thickness="2" />
        <Fill color="#ffff9414" />
      </Ellipse>
      <Ellipse x="13" y="13" width="12" height="12">
        <Fill color="#ff151515" />
      </Ellipse>
    </PartDraw>
  </Scene>
</WatchFace>
