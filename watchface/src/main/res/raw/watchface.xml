<?xml version="1.0"?>
<!--
    Field Data Pixel

    A deliberately quiet, data-first digital face: local time, date, steps,
    and battery level. The face is resource-only and uses Watch Face Format 1.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <Scene backgroundColor="#ff101512">
    <!-- Fine circular field grid. It disappears in ambient mode. -->
    <PartDraw x="0" y="0" width="450" height="450" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Ellipse x="18" y="18" width="414" height="414">
        <Stroke color="#ff26322b" thickness="2" />
      </Ellipse>
      <Ellipse x="42" y="42" width="366" height="366">
        <Stroke color="#ff1d2822" thickness="2" />
      </Ellipse>
    </PartDraw>

    <!-- Header -->
    <PartText x="44" y="44" width="362" height="34">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#ffc8d7c9">
          FIELD DATA
        </Font>
      </Text>
    </PartText>
    <PartDraw x="82" y="88" width="286" height="2">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Rectangle x="0" y="0" width="286" height="2">
        <Fill color="#ff76907d" />
      </Rectangle>
    </PartDraw>

    <!-- Date -->
    <PartText x="45" y="108" width="360" height="36">
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="25" color="#ff8fa89a">
          <Template><![CDATA[%s  ·  %02d %s]]>
            <Parameter expression="[DAY_OF_WEEK_S]" />
            <Parameter expression="[DAY]" />
            <Parameter expression="[MONTH_S]" />
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- Main time, with a thinner monochrome ambient treatment. -->
    <DigitalClock x="0" y="0" width="450" height="450">
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="151" width="450" height="112" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Font family="SYNC_TO_DEVICE" size="112" weight="BOLD" color="#fff4fbf5" />
      </TimeText>
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="151" width="450" height="112" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255" />
        <Font family="SYNC_TO_DEVICE" size="112" weight="THIN" color="#ffdae5dc" />
      </TimeText>
    </DigitalClock>

    <!-- Small live-data divider -->
    <PartDraw x="62" y="279" width="326" height="2">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Rectangle x="0" y="0" width="326" height="2">
        <Fill color="#ff33443a" />
      </Rectangle>
    </PartDraw>

    <!-- Steps -->
    <PartText x="54" y="298" width="156" height="26">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="LEFT">
        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#ff76907d">
          STEPS
        </Font>
      </Text>
    </PartText>
    <PartText x="54" y="322" width="170" height="50">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="LEFT">
        <Font family="SYNC_TO_DEVICE" size="37" weight="BOLD" color="#ffc9f27b">
          <Template><![CDATA[%05d]]>
            <Parameter expression="[STEP_COUNT]" />
          </Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="54" y="366" width="170" height="26">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="LEFT">
        <Font family="SYNC_TO_DEVICE" size="19" color="#ff8fa89a">
          <Template><![CDATA[%d%% OF GOAL]]>
            <Parameter expression="[STEP_PERCENT]" />
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- Battery -->
    <PartText x="274" y="298" width="122" height="26">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="RIGHT">
        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#ff76907d">
          BATTERY
        </Font>
      </Text>
    </PartText>
    <PartText x="244" y="322" width="152" height="50">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="RIGHT">
        <Font family="SYNC_TO_DEVICE" size="37" weight="BOLD" color="#ffffb86b">
          <Template><![CDATA[%d%%]]>
            <Parameter expression="[BATTERY_PERCENT]" />
          </Template>
        </Font>
      </Text>
    </PartText>
    <PartDraw x="274" y="380" width="122" height="4">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Rectangle x="0" y="0" width="122" height="4">
        <Fill color="#ff26322b" />
      </Rectangle>
      <Rectangle x="0" y="0" width="122" height="4">
        <Fill color="#ffffb86b" />
      </Rectangle>
    </PartDraw>

    <!-- A simple ambient footer keeps the face useful without glow or grid. -->
    <PartText x="54" y="366" width="342" height="26" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="19" color="#ffdae5dc">
          <Template><![CDATA[%05d  ·  %d%%]]>
            <Parameter expression="[STEP_COUNT]" />
            <Parameter expression="[BATTERY_PERCENT]" />
          </Template>
        </Font>
      </Text>
    </PartText>
  </Scene>
</WatchFace>
